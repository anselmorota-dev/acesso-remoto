# Configuração do app (pública — nada secreto aqui).
# Variáveis com prefixo RENDERER_VITE_ ficam visíveis para o renderer.

# Endereço do servidor de sinalização em desenvolvimento (npm run dev).
# Em produção (npm run build / npm run preview) vale o .env.production (Render).
RENDERER_VITE_SERVIDOR_URL=ws://localhost:8080
