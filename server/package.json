{
  "name": "@acesso-remoto/server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de sinalização (IDs e conexão entre pares)",
  "type": "module",
  "exports": {
    "./servidor": "./src/servidor.ts",
    "./instalacoes": "./src/instalacoes.ts",
    "./auxiliares-teste": "./src/auxiliares-teste.ts"
  },
  "scripts": {
